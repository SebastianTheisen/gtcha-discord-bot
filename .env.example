# Discord Bot Token (aus Discord Developer Portal)
DISCORD_TOKEN=dein_bot_token_hier

# Discord Server ID (Rechtsklick auf Server → ID kopieren)
GUILD_ID=123456789

# Forum Channel IDs
CHANNEL_BONUS=123456789
CHANNEL_MIX=123456789
CHANNEL_YUGIOH=123456789
CHANNEL_POKEMON=123456789
CHANNEL_WEISS_SCHWARZ=123456789
CHANNEL_ONE_PIECE=123456789
CHANNEL_HOBBY=123456789

# Premium-Foren (optional): jeder Banner zusätzlich mit allen Infos, zeitversetzt (Einstellung im Tracker)
PREMIUM_CHANNEL_BONUS=
PREMIUM_CHANNEL_MIX=
PREMIUM_CHANNEL_POKEMON=
PREMIUM_CHANNEL_ONE_PIECE=
PREMIUM_CHANNEL_DRAGON_BALL=

# Scraper Einstellungen
SCRAPE_INTERVAL_MINUTES=5
BASE_URL=https://gtchaxonline.com
DATABASE_PATH=data/gtcha_bot.db
LOG_LEVEL=INFO

# Web-App: wer Admin ist (Discord-Ansicht einstellen, Statistiken aller Nutzer sehen).
# Deine Discord-ID (in der App unter „Ich“ → „Discord verknüpfen“ angezeigt). Leer = niemand ist Admin.
APP_ADMIN_IDS=

# Übersetzung japanischer Karten-/Pack-Namen: Wörterbuch + MyMemory (kostenlos, ohne Anmeldung) für den Rest.
# Optional statt MyMemory DeepL (oft besser): Key von https://www.deepl.com/pro-api eintragen. Leer = MyMemory.
DEEPL_API_KEY=
