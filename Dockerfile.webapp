# GTCHA Tracker - Web-App neben dem Bot (liest dessen Datenbank, kein Browser nötig)
FROM python:3.11-slim-bookworm

ENV PYTHONUNBUFFERED=1
WORKDIR /app

COPY requirements-webapp.txt .
RUN pip install --no-cache-dir -r requirements-webapp.txt

COPY config.py ./
COPY database ./database
COPY utils ./utils
COPY webapp ./webapp

CMD ["python", "-m", "webapp.server"]
